# Scaleo API
SCALEO_API_BASE=https://your-api-url
SCALEO_API_KEY=your_scaleo_api_key

# Google Sheets
SHEET_ID=your_google_sheet_id
WORKSHEET_NAME=your_worksheet_name
GOOGLE_CREDENTIALS_FILE=credentials.json

# Which offers to read (inclusive range of offer IDs)
FIRST_OFFER_ID=1
LAST_OFFER_ID=1000

# How many API requests may run at the same time
MAX_CONCURRENT_REQUESTS=15
